@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@model WebGallery.UI.ViewModels.Customizer.SearchesViewModel

@{
    int totalTaggedItems = Model.AllTags.Sum(s => s.Count);
}

<!-- Search Section -->
<div class="row pt-4 mb-5 text-center mx-0">
    <div class="col-12">
        <!-- Collapsible Header -->
        <h3 class="text-white mb-4" data-bs-toggle="collapse" data-bs-target="#searchFormContainer" aria-expanded="true" aria-controls="searchFormContainer" style="cursor: pointer;">
            Search
        </h3>

        <!-- Saved Searches Dropdown -->
        <div class="mb-3" style="max-width:600px;margin:0 auto;">
            <div class="input-group">
                <select id="savedSearchesDropdown" class="form-select">
                    <option value="">-- Select a saved search --</option>
                    @foreach (var search in Model.SavedSearches)
                    {
                        <option value="@search.SearchName"
                                data-albums="@search.Albums"
                                data-tags="@search.Tags"
                                data-fileextensions="@search.FileExtensions"
                                data-medianamecontains="@search.MediaNameContains"
                                data-alltagsmustmatch="@search.AllTagsMustMatch"
                                data-maxsize="@search.MaxSize"
                                data-minfilesize="@search.MinFileSize"
                                data-maxfilesize="@search.MaxFileSize"
                                data-createdafter="@search.CreatedAfter"
                                data-createdbefore="@search.CreatedBefore">
                            @search.SearchName
                        </option>
                    }
                </select>
                <button type="button" class="btn btn-danger" id="deleteSavedSearchBtn" title="Delete selected search" style="margin-left:10px;">Delete</button>
            </div>
        </div>

        <!-- Collapsible Form -->
        <div class="collapse show" id="searchFormContainer">
            <form method="get" action="/single/search" class="search-form" id="searchForm" onsubmit="return handleSearchFormSubmit(event)">
                <div class="form-group">
                    <select id="albumsInput" name="albums" class="form-control" data-select-albums multiple>
                        @foreach (var album in Model.AllAlbums)
                        {
                            <option value="@album.AlbumName" data-count="@album.Count">@album.AlbumName</option>
                        }
                    </select>
                    <span id="albumMatchCount" data-total-items="@Model.TotalItems" class="small">Albums: @Model.TotalItems of @Model.TotalItems</span><br />
                </div>
                <div class="form-group">
                    <select id="tagsInput" name="tags" class="form-control" data-select-tags multiple>
                        @foreach (var tag in Model.AllTags)
                        {
                            <option value="@tag.TagName" data-count="@tag.Count">@tag.TagName</option>
                        }
                    </select>
                    <span id="tagMatchCount" data-total-items="@totalTaggedItems" class="small">Tags: @totalTaggedItems of @totalTaggedItems</span>
                </div>
                <div class="form-check mb-3">
                    <input type="checkbox" name="allTagsMustMatch" class="form-check-input" id="allTagsMustMatch" value="true">
                    <label class="form-check-label text-white" for="allTagsMustMatch">All tags must match</label>
                </div>
                <div class="form-group">
                    <input type="text" name="fileExtensions" class="form-control" placeholder="File Extensions (e.g., jpg, png)" id="fileExtensionsInput">
                </div>
                <div class="form-group">
                    <input type="text" name="mediaNameContains" class="form-control" placeholder="Filename (partial match)" id="mediaNameContainsInput">
                </div>
                <div class="form-group">
                    <label class="form-label text-white" for="minFileSizeInput">Minimum file size (MB):</label>
                    <input type="number" name="minFileSize" class="form-control" id="minFileSizeInput" min="0" step="0.1">
                </div>
                <div class="form-group">
                    <label class="form-label text-white" for="maxFileSizeInput">Maximum file size (MB):</label>
                    <input type="number" name="maxFileSize" class="form-control" id="maxFileSizeInput" min="0" step="0.1">
                </div>
                <div class="form-group">
                    <label class="form-label text-white" for="createdAfterInput">Created after:</label>
                    <input type="date" name="createdAfter" class="form-control" placeholder="Created After Date" id="createdAfterInput">
                    <div class="date-range-shortcuts mt-2">
                        <a href="#" class="date-range-shortcut" data-relative-date-range="7">Last 7 days</a>
                        <span class="date-range-separator">|</span>
                        <a href="#" class="date-range-shortcut" data-relative-date-range="14">Last 14 days</a>
                        <span class="date-range-separator">|</span>
                        <a href="#" class="date-range-shortcut" data-relative-date-range="30">Last 30 days</a>
                    </div>
                </div>
                <div class="form-group">
                    <label class="form-label text-white" for="createdBeforeInput">Created before:</label>
                    <input type="date" name="createdBefore" class="form-control" placeholder="Created Before Date" id="createdBeforeInput">
                </div>
                <div class="form-group">
                    <label class="form-label text-white" for="maxSizeInput">Max search size:</label>
                    <input type="number" name="maxSize" class="form-control" id="maxSizeInput" value="200" min="1" max="@Model.TotalItems" step="1" data-total-items="@Model.TotalItems">
                    <small id="maxSizeWarning" class="text-warning" style="display:none;">Values above 200 may affect search performance.</small>
                </div>
                <div class="form-check mb-3">
                    <input type="checkbox" name="shuffle" class="form-check-input" id="shuffle" value="true">
                    <label class="form-check-label text-white" for="shuffle">Shuffle results</label>
                </div>
                <div class="button-row">
                    <button type="submit" class="btn btn-primary">Search</button>
                    <button type="button" class="btn btn-secondary" id="saveSearchBtn">Save Search</button>
                </div>
                <span id="saveSearchStatus" style="margin-left:10px;color:#ef6c57;display:none;"></span>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script type="text/javascript" src="~/js/view-listener-customizer.js"></script>
}
