@using Infrastructure.MinimalApi
@model List<WatchHistoryItemDTO>

<main class="main-content">
<div class="container-fluid mt-5 px-4">
    <h2 class="mb-4">Watch history</h2>

    @if (Model == null || Model.Count == 0)
    {
        <div class="alert alert-info">No videos have been played yet.</div>
    }
    else
    {
        <ul class="list-unstyled">
            @foreach (var item in Model)
            {
                <li class="mb-2">
                    @{ string href = string.IsNullOrEmpty(item.MediaId)
                        ? "/Bio/id/" + System.Uri.EscapeDataString(item.MediaName)
                        : "/Bio/open/" + System.Uri.EscapeDataString(item.Album) + "/" + System.Uri.EscapeDataString(item.MediaId); }
                    <a class="regular-text-link text-white" href="@href">@item.MediaName</a>
                </li>
            }
        </ul>
    }
</div>
</main>
