{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "WebGallery.UI",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-ui",
            "program": "${workspaceFolder}/UI/WebGallery.UI/bin/Debug/net10.0/WebGallery.UI.dll",
            "args": [],
            "cwd": "${workspaceFolder}/UI/WebGallery.UI",
            "stopAtEntry": false,
        "env": {},
        "serverReadyAction": {
            "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
            "uriFormat": "{0}",
            "action": "openExternally"
        },
        "presentation": {
            "hidden": false,
            "group": "1-Individual",
            "order": 1
        }
    },
    {
        "name": "MinimalGallery.API",
        "type": "coreclr",
        "request": "launch",
        "preLaunchTask": "build-api",
        "program": "${workspaceFolder}/API/bin/Debug/net10.0/MinimalGallery.API.dll",
        "args": [],
        "cwd": "${workspaceFolder}/API",
        "stopAtEntry": false,
        "env": {
            "WEBGALLERY_HTTPS_PORT": "5041",
            "WEBGALLERY_HTTP_PORT": "5042"
        },
        "serverReadyAction": {
            "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
            "uriFormat": "{0}",
            "action": "openExternally"
        },
        "presentation": {
            "hidden": false,
            "group": "1-Individual",
            "order": 2
            }
    },
    {
        "name": "WebGallery.FileServer",
        "type": "coreclr",
        "request": "launch",
        "preLaunchTask": "build-fileserver",
        "program": "${workspaceFolder}/FileServer/bin/Debug/net10.0/WebGallery.FileServer.dll",
        "args": [],
        "cwd": "${workspaceFolder}/FileServer",
        "stopAtEntry": false,
        "env": {
            "WEBGALLERY_HTTPS_PORT": "5031",
            "WEBGALLERY_HTTP_PORT": "5032"
        },
        "serverReadyAction": {
            "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
            "uriFormat": "{0}",
            "action": "openExternally"
        },
        "presentation": {
            "hidden": false,
            "group": "1-Individual",
            "order": 3
        }
    }
    ],
    "compounds": [
    {
        "name": "All Services",
        "configurations": [
            "WebGallery.UI",
            "MinimalGallery.API",
            "WebGallery.FileServer"
        ],
        "stopAll": true,
        "presentation": {
            "group": "2-Combined"
        }
    }
    ]
}