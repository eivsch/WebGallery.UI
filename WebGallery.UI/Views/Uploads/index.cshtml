@model WebGallery.UI.ViewModels.Uploads.UploadsViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<div class="container mt-5">
    <h3 class="text-center mb-4">Upload Images</h3>
    <p class="text-muted text-center">
        Please select an album name and upload one or more images, videos, gifs etc.
    </p>
    <form action="uploads/large" method="post" enctype="multipart/form-data" class="upload-form">
        <div class="form-group mb-3">
            <label for="AlbumName" class="form-label">Album Name:</label>
            <input asp-for="AlbumName" class="form-control" id="AlbumName" placeholder="Enter album name">
        </div>
        <div class="form-group mb-3">
            <label for="FilesToUpload" class="form-label">Select Images to Upload:</label>
            <input asp-for="FilesToUpload" class="form-control" id="FilesToUpload" type="file" multiple>
        </div>
        <div class="form-group text-center">
            <input type="submit" value="Upload Images" name="submit" class="btn btn-primary">
        </div>
    </form>
    <div class="progress mt-3" id="uploadProgress" style="display: none;">
        <div class="progress-bar" role="progressbar" style="width: 0%;" id="progressBar"></div>
    </div>
</div>

<script>
    const form = document.querySelector('.upload-form');
    const submitButton = form.querySelector('input[type="submit"]');
    const albumNameInput = document.getElementById('AlbumName');
    const filesInput = document.getElementById('FilesToUpload');
    const progressBar = document.getElementById('progressBar');
    const progressContainer = document.getElementById('uploadProgress');
    const uploadSummaryStorageKey = 'webgallery.upload.summary';
    const chunkSize = 100;
    let isUploading = false;

    form.addEventListener('submit', async function (e) {
        e.preventDefault(); // Prevent the default form submission

        if (isUploading) {
            return;
        }

        const albumName = albumNameInput.value.trim();
        const files = Array.from(filesInput.files || []);

        if (!albumName) {
            alert('Please enter an album name.');
            return;
        }

        if (files.length === 0) {
            alert('Please select one or more files to upload.');
            return;
        }

        isUploading = true;
        submitButton.disabled = true;
        submitButton.value = 'Uploading...';
        progressContainer.style.display = 'block';
        progressBar.style.width = '0%';
        progressBar.textContent = '0%';

        const totalBytes = files.reduce((sum, file) => sum + (file.size || 0), 0);
        const totalChunks = Math.ceil(files.length / chunkSize);
j
        let uploadedBytesFromCompletedChunks = 0;
        let lastSuccessHtml = '';
        let totalUploadedCount = 0;
        const recentUploadedFiles = [];

        const uploadChunk = (chunkFiles, chunkIndex) => {
            return new Promise((resolve, reject) => {
                const formData = new FormData();
                formData.append('AlbumName', albumName);

                for (const file of chunkFiles) {
                    formData.append('FilesToUpload', file, file.name);
                }

                const xhr = new XMLHttpRequest();
                xhr.open('POST', form.action, true);

                xhr.upload.onprogress = function (progressEvent) {
                    if (!progressEvent.lengthComputable || totalBytes <= 0) {
                        return;
                    }

                    const uploadedBytesCurrentChunk = progressEvent.loaded;
                    const uploadedBytesOverall = uploadedBytesFromCompletedChunks + uploadedBytesCurrentChunk;
                    const percentComplete = Math.min(100, (uploadedBytesOverall / totalBytes) * 100);

                    progressBar.style.width = percentComplete + '%';
                    progressBar.textContent = `${Math.round(percentComplete)}% (${chunkIndex + 1}/${totalChunks})`;
                };

                xhr.onload = function () {
                    if (xhr.status === 200) {
                        resolve(xhr.responseText);
                    } else {
                        reject(new Error(`Upload failed for chunk ${chunkIndex + 1} with status ${xhr.status}.`));
                    }
                };

                xhr.onerror = function () {
                    reject(new Error(`Network error while uploading chunk ${chunkIndex + 1}.`));
                };

                xhr.onabort = function () {
                    reject(new Error(`Upload aborted for chunk ${chunkIndex + 1}.`));
                };

                xhr.send(formData);
            });
        };

        try {
            for (let i = 0; i < files.length; i += chunkSize) {
                const chunkFiles = files.slice(i, i + chunkSize);
                const chunkIndex = Math.floor(i / chunkSize);
                lastSuccessHtml = await uploadChunk(chunkFiles, chunkIndex);

                const chunkBytes = chunkFiles.reduce((sum, file) => sum + (file.size || 0), 0);
                uploadedBytesFromCompletedChunks += chunkBytes;
                totalUploadedCount += chunkFiles.length;

                for (const file of chunkFiles) {
                    recentUploadedFiles.push({
                        fileName: file.name,
                        fileSize: file.size || 0
                    });
                }

                if (recentUploadedFiles.length > 100) {
                    recentUploadedFiles.splice(0, recentUploadedFiles.length - 100);
                }
            }

            progressBar.style.width = '100%';
            progressBar.textContent = '100%';

            sessionStorage.setItem(uploadSummaryStorageKey, JSON.stringify({
                albumName,
                totalUploadedCount,
                recentUploadedFiles
            }));

            // Render the success page returned by the final chunk request.
            document.open();
            document.write(lastSuccessHtml);
            document.close();
        } catch (error) {
            isUploading = false;
            submitButton.disabled = false;
            submitButton.value = 'Upload Images';
            alert(error.message || 'Upload failed. Please try again.');
        }
    });
</script>