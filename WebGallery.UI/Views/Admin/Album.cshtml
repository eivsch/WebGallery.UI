@model Infrastructure.MinimalApi.AlbumContentsDTO;
@{
    var albumName = ViewBag.AlbumName as string;
    var allAlbums = ViewBag.AllAlbums as IEnumerable<Infrastructure.MinimalApi.AlbumMetaDTO>;
    var adminMessage = TempData["AdminAlbumMessage"] as string;
    var adminError = TempData["AdminAlbumError"] as string;
    var albumNames = new List<string>();
    if (allAlbums != null)
    {
        foreach (var album in allAlbums)
        {
            albumNames.Add(album.AlbumName);
        }
    }
}
<main class="main-content">
<div class="container-fluid mt-5 admin-page-shell">
    <h2 class="mb-4">Admin: '@albumName' Contents</h2>

    @if (string.IsNullOrWhiteSpace(adminMessage) == false)
    {
        <div class="alert alert-success">@adminMessage</div>
    }

    @if (string.IsNullOrWhiteSpace(adminError) == false)
    {
        <div class="alert alert-danger">@adminError</div>
    }

    <!-- Primary Action Buttons -->
    <div class="btn-toolbar mb-3 admin-album-toolbar" role="toolbar">
        <div class="btn-group me-2" role="group">
            <a href="/admin" class="btn btn-outline-secondary">← Back</a>
            <a href="/uploads?albumName=@albumName" class="btn btn-success">+ Add items</a>
            <a href="/albums/@albumName" class="btn btn-primary">👁 View album</a>
        </div>
        <div class="btn-group" role="group">
            <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#advancedOptions" aria-expanded="false" aria-controls="advancedOptions">
                ⚙ Advanced
            </button>
        </div>
    </div>

    <!-- Advanced Options (Collapsed) -->
    <div class="collapse mb-3" id="advancedOptions">
        <div class="card card-body bg-dark border-secondary">
            <div class="btn-group-vertical w-100" role="group">
                <button type="button" class="btn btn-outline-warning text-start rename-album-btn" data-album-name="@albumName">
                    ✏ Rename album
                </button>
                <a href="/admin/albums/@albumName/rebuild-index?type=name" class="btn btn-outline-info text-start" onclick="event.stopPropagation(); return confirm('Are you sure you want to rebuild the index? This will change the order of the items in alphabetical order.');">
                    ↻ Rebuild on name
                </a>
                <a href="/admin/albums/@albumName/rebuild-index?type=date" class="btn btn-outline-info text-start" onclick="event.stopPropagation(); return confirm('Are you sure you want to rebuild the index? This will change the order of the items according to the date they were added.');">
                    ↻ Rebuild on date
                </a>
            </div>
        </div>
    </div>
    @if (Model.Items == null || !Model.Items.Any())
    {
        <div class="alert alert-info">No files in this album.</div>
    }
    else
    {
        <div class="mb-3 admin-bulk-actions" id="bulkActionsContainer" style="display: none;">
            <div class="btn-group" role="group">
                <button id="moveSelectedBtn" type="button" class="btn btn-outline-warning" disabled>↔ Move Selected</button>
                <button id="deleteSelectedBtn" type="button" class="btn btn-outline-danger" disabled>🗑 Delete Selected</button>
            </div>

            <form id="bulkDeleteForm" asp-action="DeleteFiles" asp-controller="Admin" asp-route-albumName="@albumName" method="post" class="d-none">
                @Html.AntiForgeryToken()
                <div id="bulkDeleteHiddenInputs"></div>
            </form>
        </div>

        <table class="table table-dark table-striped admin-album-table admin-album-table--contents">
            <thead>
                <tr>
                    <th></th>
                    <th>Filename</th>
                    <th>Size (KB)</th>
                    <th>Created</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var file in Model.Items)
            {
                <tr>
                    <td class="align-middle">
                        <input type="checkbox"
                               class="file-checkbox"
                               data-file-name="@file.Name"
                               data-media-locator="@file.Id" />
                    </td>
                    <td><a class="regular-text-link" href="/Bio/id/@file.Id">@file.Name</a></td>
                    @if (file.Size.HasValue)
                    {
                        <td>@Math.Round((file.Size.Value / 1024.0M), 1)</td>
                    }
                    else
                    {
                        <td>N/A</td>
                    }
                    <td>@file.Created.ToString("yyyy-MM-dd HH:mm:ss")</td>
                    <td class="admin-album-table__actions">
                        <form asp-action="DeleteFile" asp-controller="Admin" asp-route-albumName="@albumName" method="post" class="d-inline-block" onsubmit="return confirm('Delete this file?');">
                            <input type="hidden" name="fileName" value="@file.Name" />
                            <button type="submit" class="btn btn-outline-danger btn-sm me-1">🗑 Delete</button>
                            @Html.AntiForgeryToken()
                        </form>
                        <button type="button"
                                class="btn btn-outline-warning btn-sm me-1 rename-file-btn"
                                data-file-name="@file.Name"
                                data-media-locator="@file.Id">
                            ✏ Rename
                        </button>
                        <button type="button"
                                class="btn btn-outline-info btn-sm move-file-btn"
                                data-file-name="@file.Name"
                                data-media-locator="@file.Id">
                            ↔ Move
                        </button>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
</div>
</main>

<div class="modal fade" id="moveFileModal" tabindex="-1" aria-labelledby="moveFileModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="moveFileForm" asp-action="MoveFiles" asp-controller="Admin" asp-route-albumName="@albumName" method="post">
                <div class="modal-header">
                    <h5 class="modal-title" id="moveFileModalLabel">Move file</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    @Html.AntiForgeryToken()

                    <div id="moveItemsHiddenInputs"></div>

                    <div class="mb-3">
                        <label for="moveTargetAlbumSelect" class="form-label">Target album</label>
                        <select id="moveTargetAlbumSelect" class="form-select" name="targetAlbum" required>
                            <option value="">-- Select target album --</option>
                        </select>
                    </div>
                    <p id="moveFileDescription" class="text-muted mb-0"></p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning">Move</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const moveModalEl = document.getElementById('moveFileModal');
            const moveButtons = document.querySelectorAll('.move-file-btn');
            const renameButtons = document.querySelectorAll('.rename-file-btn');
            const fileCheckboxes = document.querySelectorAll('.file-checkbox');
            const moveSelectedBtn = document.getElementById('moveSelectedBtn');
            const deleteSelectedBtn = document.getElementById('deleteSelectedBtn');
            const bulkDeleteForm = document.getElementById('bulkDeleteForm');
            const bulkDeleteHiddenInputs = document.getElementById('bulkDeleteHiddenInputs');

            if (!moveModalEl || !window.bootstrap) {
                return;
            }

            const moveModal = new bootstrap.Modal(moveModalEl);
            const moveFileForm = document.getElementById('moveFileForm');
            const moveTargetAlbumSelect = document.getElementById('moveTargetAlbumSelect');
            const moveItemsHiddenInputs = document.getElementById('moveItemsHiddenInputs');
            const moveFileDescription = document.getElementById('moveFileDescription');

            const currentAlbum = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(albumName ?? string.Empty));
            const albumNames = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(albumNames));
            let optionsLoaded = false;

            function getSelectedFiles() {
                return Array.from(document.querySelectorAll('.file-checkbox:checked')).map((cb) => ({
                    fileName: cb.getAttribute('data-file-name') || '',
                    mediaLocator: cb.getAttribute('data-media-locator') || ''
                }));
            }

            function updateBulkButtonsState() {
                const selectedCount = getSelectedFiles().length;
                const bulkActionsContainer = document.getElementById('bulkActionsContainer');
                
                if (selectedCount > 0) {
                    bulkActionsContainer.style.display = 'block';
                    moveSelectedBtn.disabled = false;
                    deleteSelectedBtn.disabled = false;
                } else {
                    bulkActionsContainer.style.display = 'none';
                    moveSelectedBtn.disabled = true;
                    deleteSelectedBtn.disabled = true;
                }
            }

            function loadTargetAlbumOptions() {
                if (optionsLoaded) {
                    return;
                }

                for (const album of albumNames) {
                    if (!album || album.toLowerCase() === currentAlbum.toLowerCase()) {
                        continue;
                    }

                    const option = document.createElement('option');
                    option.value = album;
                    option.textContent = album;
                    moveTargetAlbumSelect.appendChild(option);
                }

                optionsLoaded = true;
            }

            function openMoveModal(items) {
                loadTargetAlbumOptions();

                moveItemsHiddenInputs.innerHTML = '';
                items.forEach((item) => {
                    const fileNameInput = document.createElement('input');
                    fileNameInput.type = 'hidden';
                    fileNameInput.name = 'fileNames';
                    fileNameInput.value = item.fileName;
                    moveItemsHiddenInputs.appendChild(fileNameInput);

                    const mediaLocatorInput = document.createElement('input');
                    mediaLocatorInput.type = 'hidden';
                    mediaLocatorInput.name = 'mediaLocators';
                    mediaLocatorInput.value = item.mediaLocator || item.fileName;
                    moveItemsHiddenInputs.appendChild(mediaLocatorInput);
                });

                moveTargetAlbumSelect.value = '';

                if (items.length === 1) {
                    const singleName = items[0].fileName;
                    moveFileDescription.textContent = singleName ? `Move '${singleName}' to another album.` : 'Move this file to another album.';
                } else {
                    moveFileDescription.textContent = `Move ${items.length} selected files to another album.`;
                }

                moveModal.show();
            }

            moveButtons.forEach((button) => {
                button.addEventListener('click', () => {
                    const fileName = button.getAttribute('data-file-name') || '';
                    const mediaLocator = button.getAttribute('data-media-locator') || fileName;
                    openMoveModal([{ fileName, mediaLocator }]);
                });
            });

            renameButtons.forEach((button) => {
                button.addEventListener('click', () => {
                    const fileName = button.getAttribute('data-file-name') || '';
                    const mediaLocator = button.getAttribute('data-media-locator') || fileName;
                    const newFileName = window.prompt('Enter a new file name for: ' + fileName, fileName);
                    if (newFileName === null) {
                        return;
                    }

                    const trimmed = newFileName.trim();
                    if (!trimmed) {
                        window.alert('File name cannot be empty.');
                        return;
                    }

                    if (trimmed.toLowerCase() === fileName.toLowerCase()) {
                        return;
                    }

                    const form = document.createElement('form');
                    form.method = 'post';
                    form.action = '/Admin/albums/' + encodeURIComponent(currentAlbum) + '/rename-file';

                    const fileNameInput = document.createElement('input');
                    fileNameInput.type = 'hidden';
                    fileNameInput.name = 'fileName';
                    fileNameInput.value = fileName;
                    form.appendChild(fileNameInput);

                    const mediaLocatorInput = document.createElement('input');
                    mediaLocatorInput.type = 'hidden';
                    mediaLocatorInput.name = 'mediaLocator';
                    mediaLocatorInput.value = mediaLocator;
                    form.appendChild(mediaLocatorInput);

                    const newFileNameInput = document.createElement('input');
                    newFileNameInput.type = 'hidden';
                    newFileNameInput.name = 'newFileName';
                    newFileNameInput.value = trimmed;
                    form.appendChild(newFileNameInput);

                    const token = document.querySelector('input[name="__RequestVerificationToken"]');
                    if (token) {
                        form.appendChild(token.cloneNode(true));
                    }

                    document.body.appendChild(form);
                    form.submit();
                });
            });

            if (moveSelectedBtn) {
                moveSelectedBtn.addEventListener('click', () => {
                    const selectedFiles = getSelectedFiles();
                    if (!selectedFiles.length) {
                        return;
                    }

                    openMoveModal(selectedFiles);
                });
            }

            if (deleteSelectedBtn && bulkDeleteForm && bulkDeleteHiddenInputs) {
                deleteSelectedBtn.addEventListener('click', () => {
                    const selectedFiles = getSelectedFiles();
                    if (!selectedFiles.length) {
                        return;
                    }

                    const shouldDelete = confirm(`Delete ${selectedFiles.length} selected file(s)?`);
                    if (!shouldDelete) {
                        return;
                    }

                    bulkDeleteHiddenInputs.innerHTML = '';
                    selectedFiles.forEach((item) => {
                        const input = document.createElement('input');
                        input.type = 'hidden';
                        input.name = 'fileNames';
                        input.value = item.fileName;
                        bulkDeleteHiddenInputs.appendChild(input);
                    });

                    bulkDeleteForm.submit();
                });
            }

            fileCheckboxes.forEach((checkbox) => {
                checkbox.addEventListener('change', updateBulkButtonsState);
            });

            updateBulkButtonsState();

            moveFileForm.addEventListener('submit', (event) => {
                const selectedTarget = (moveTargetAlbumSelect.value || '').trim();
                if (!selectedTarget) {
                    event.preventDefault();
                    alert('Please select a target album.');
                    return;
                }

                if (selectedTarget.toLowerCase() === currentAlbum.toLowerCase()) {
                    event.preventDefault();
                    alert('Target album must be different from source album.');
                    return;
                }
            });

            document.querySelectorAll('.rename-album-btn').forEach((button) => {
                button.addEventListener('click', () => {
                    const currentAlbumName = button.getAttribute('data-album-name');
                    const newAlbumName = window.prompt('Enter a new album name for: ' + currentAlbumName, currentAlbumName);
                    if (newAlbumName === null) {
                        return;
                    }

                    const trimmed = newAlbumName.trim();
                    if (!trimmed) {
                        window.alert('Album name cannot be empty.');
                        return;
                    }

                    if (trimmed.toLowerCase() === currentAlbumName.toLowerCase()) {
                        return;
                    }

                    const form = document.createElement('form');
                    form.method = 'post';
                    form.action = '/Admin/rename';

                    const albumInput = document.createElement('input');
                    albumInput.type = 'hidden';
                    albumInput.name = 'albumName';
                    albumInput.value = currentAlbumName;
                    form.appendChild(albumInput);

                    const newAlbumInput = document.createElement('input');
                    newAlbumInput.type = 'hidden';
                    newAlbumInput.name = 'newAlbumName';
                    newAlbumInput.value = trimmed;
                    form.appendChild(newAlbumInput);

                    const token = document.querySelector('input[name="__RequestVerificationToken"]');
                    if (token) {
                        form.appendChild(token.cloneNode(true));
                    }

                    document.body.appendChild(form);
                    form.submit();
                });
            });
        })();
    </script>
}