@section Scripts {
    @{ int configuredPageSize = Configuration.GetValue<int>("Display:PageSize", 48); }
    @{ int configuredPaginationWindowSize = Configuration.GetValue<int>("Display:PaginationWindowSize", 7); }
    <script type="text/javascript">
        window.webGalleryDisplay = {
            pageSize: @configuredPageSize,
            paginationWindowSize: @configuredPaginationWindowSize
        };
    </script>
    <script type="module" src="~/js/view-listener-tags.js"></script>
