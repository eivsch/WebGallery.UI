@using Microsoft.Extensions.Configuration
@using WebGallery.UI.Models

@model WebGallery.UI.ViewModels.Albums.AlbumsViewModel

@inject IConfiguration Configuration

@{
    string fileServerUrl = $"/files";
    int pageSize = Math.Max(1, Model.DisplayCount);
    int totalPages = Math.Max(1, (int)Math.Ceiling((double)Model.TotalAlbumCount / pageSize));
    int currentPage = Math.Min(totalPages, (Model.CurrentOffset / pageSize) + 1);
    int windowSize = Math.Max(1, Configuration.GetValue<int>("Display:PaginationWindowSize", 7));
    int halfWindow = windowSize / 2;
    int firstPage = Math.Max(1, currentPage - halfWindow);
    int lastPage = Math.Min(totalPages, firstPage + windowSize - 1);
    int firstAlbumNumber = Model.Albums.Count == 0 ? 0 : Model.CurrentOffset + 1;
    int lastAlbumNumber = Model.CurrentOffset + Model.Albums.Count;
    firstPage = Math.Max(1, lastPage - windowSize + 1);
}

<main class="main-content">
    <div class="container-fluid photos">
        <div class="row pt-4 mb-5 text-center">
            <div class="col-12">
                @if (Model.IsRandomized)
                {
                    <h2 class="text-white mb-4">'Albums' &mdash; Displaying @Model.Albums.Count albums in random order</h2>
                }
                else
                {
                    <h2 class="text-white mb-4">'Albums' &mdash; Displaying @firstAlbumNumber-@lastAlbumNumber of @Model.TotalAlbumCount Albums</h2>
                }
            </div>
        </div>

        <div class="row align-items-stretch">
            @*
            Each image row has a witdh of "12", meaning col-lg-x must add up to 12 to fit it on one row

            data-aos="fade-up" data-aos-delay="100" provides an animation while loading the picture
            *@
            @foreach (var album in Model.Albums)
            {
                var appPathBytes = System.Text.Encoding.UTF8.GetBytes(album.CoverImageAppPath);
                string appPathBase64 = System.Convert.ToBase64String(appPathBytes);
                
                int offset = album.CoverImageIndex;
                string popUpDelayAtr = album.PopUpDelay == 0 ? "" : $"data-aos-delay={album.PopUpDelay}";

                <div class="col-6 col-md-6 col-lg-@album.LargeScreenSize" data-aos="fade-up" @popUpDelayAtr>
                    <a href="/Albums/@(album.GalleryId + "?offset=" + offset)" class="d-block photo-item">
                    @if (album.CoverImageMediaType == MediaType.Video)
                    {
                        string videoUri = $"/files/video/{appPathBase64}";
                        <video class="img-fluid" muted preload="metadata">
                            <source src="@videoUri" type="video/mp4" />
                        </video>
                    }
                    else
                    {
                        string imageUri = $"/files/image/{appPathBase64}";
                        <img src="@imageUri" alt="Image" class="img-fluid">
                    }
                        <div class="photo-text-more">
                            <div class="photo-text-more">
                                <h3 class="heading">@album.Title</h3>
                                <span class="meta">@album.ItemCount Photos</span>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>

        @if (!Model.IsRandomized && totalPages > 1)
        {
            int previousPage = Math.Max(1, currentPage - 1);
            int nextPage = Math.Min(totalPages, currentPage + 1);
            bool isPreviousDisabled = currentPage == 1;
            bool isNextDisabled = currentPage == totalPages;
            string randomCoverImageQuery = Model.RandomCoverImage ? "&randomCoverImage=true" : string.Empty;

            <div class="row justify-content-center mt-4 mb-3 pager-row">
                <div class="col-auto pager-col">
                    <nav class="pager-nav" aria-label="Album pages">
                        <ul class="pagination mb-0 pager-list">
                            @{
                                int firstOffset = 0;
                                string firstUri = $"/albums?offset={firstOffset}&displayCount={pageSize}{randomCoverImageQuery}";
                            }
                            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                <a class="page-link"
                                   href="@(currentPage == 1 ? "#" : firstUri)"
                                   tabindex="@(currentPage == 1 ? "-1" : null)"
                                   aria-disabled="@(currentPage == 1 ? "true" : "false")">
                                    First
                                </a>
                            </li>

                            @{
                                int previousOffset = (previousPage - 1) * pageSize;
                                string previousUri = $"/albums?offset={previousOffset}&displayCount={pageSize}{randomCoverImageQuery}";
                            }
                            <li class="page-item @(isPreviousDisabled ? "disabled" : "")">
                                <a class="page-link"
                                   href="@(isPreviousDisabled ? "#" : previousUri)"
                                   tabindex="@(isPreviousDisabled ? "-1" : null)"
                                   aria-disabled="@(isPreviousDisabled ? "true" : "false")">
                                    Previous
                                </a>
                            </li>

                            @for (int pageNumber = firstPage; pageNumber <= lastPage; pageNumber++)
                            {
                                bool isActive = pageNumber == currentPage;
                                int pageOffset = (pageNumber - 1) * pageSize;
                                string pageUri = $"/albums?offset={pageOffset}&displayCount={pageSize}{randomCoverImageQuery}";
                                <li class="page-item @(isActive ? "active" : "")">
                                    <a class="page-link"
                                       href="@(isActive ? "#" : pageUri)"
                                       tabindex="@(isActive ? "-1" : null)"
                                       aria-disabled="@(isActive ? "true" : "false")">
                                        @pageNumber
                                    </a>
                                </li>
                            }

                            @{
                                int nextOffset = (nextPage - 1) * pageSize;
                                string nextUri = $"/albums?offset={nextOffset}&displayCount={pageSize}{randomCoverImageQuery}";
                            }
                            <li class="page-item @(isNextDisabled ? "disabled" : "")">
                                <a class="page-link"
                                   href="@(isNextDisabled ? "#" : nextUri)"
                                   tabindex="@(isNextDisabled ? "-1" : null)"
                                   aria-disabled="@(isNextDisabled ? "true" : "false")">
                                    Next
                                </a>
                            </li>

                            @{
                                int lastOffset = (totalPages - 1) * pageSize;
                                string lastUri = $"/albums?offset={lastOffset}&displayCount={pageSize}{randomCoverImageQuery}";
                            }
                            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                <a class="page-link"
                                   href="@(currentPage == totalPages ? "#" : lastUri)"
                                   tabindex="@(currentPage == totalPages ? "-1" : null)"
                                   aria-disabled="@(currentPage == totalPages ? "true" : "false")">
                                    Last
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>
            </div>
        }

        <a href="/albums?randomAlbumOrder=true&displayCount=@pageSize">Random order</a>
        <a href="/albums?randomCoverImage=true&displayCount=@pageSize">Random cover image</a>
        <a href="/albums?randomAlbumOrder=true&randomCoverImage=true&displayCount=@pageSize">Random order & cover image</a>

        <div class="row justify-content-center">
            <div class="col-md-12 text-center py-5">
                <p>
                    <!-- Link back to Colorlib can't be removed. Template is licensed under CC BY 3.0. -->
                    Copyright &copy;
                    <script>document.write(new Date().getFullYear());</script> All rights reserved | This template is made with <i class="icon-heart" aria-hidden="true"></i> by <a href="https://colorlib.com" target="_blank">Colorlib</a>
                    <!-- Link back to Colorlib can't be removed. Template is licensed under CC BY 3.0. -->
                </p>
            </div>
        </div>
    </div>
</main>
